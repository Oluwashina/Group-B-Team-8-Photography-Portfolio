PORT=3001
# Comma-separated: local Vite + your Vercel URL
CLIENT_URL=http://localhost:5173,https://your-project.vercel.app
# Neon: paste their string; uselibpqcompat=true avoids pg SSL console warnings
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&uselibpqcompat=true
SESSION_SECRET=generate-a-long-random-string-here
# Production (Vercel + separate API): COOKIE_SECURE=true and COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
